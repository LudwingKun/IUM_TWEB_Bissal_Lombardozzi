{
  "openapi": "3.0.0",
    "info": {
        "title": "OpenAPI about MoviesHub",
        "version": "1.0.0",
        "description": "Api to retrieve information about movies, actors, reviews and oscar awards."
    },

  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],

    "paths": {
      "/": {
        "get": {
          "summary": "Get index data",
          "tags" : ["Index"],
          "responses": {
            "200": {
              "description": "Index data retrieved successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/IndexData"
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error"
            }
          }
        }
      },

        "/movies": {
        "get": {
            "summary": "Get a list of movies",
            "tags" : ["Movies"],
            "responses": {
            "200": {
                "description": "A list of movies",
                "content": {
                "application/json": {
                    "schema": {
                    "$ref": "#/components/schemas/MovieDetails"
                    }
                }
                }
            },
            "500": {
                "description": "Internal server error"
            }
            }
        }
      },

        "/movies/{id}": {
        "get": {
            "summary": "Get a movie by ID",
            "tags" : ["Movies"],
            "parameters": [
            {
                "name": "id",
                "in": "path",
                "required": true,
                "schema": {
                "type": "string"
                }
            }
            ],
            "responses": {
            "200": {
                "description": "A movie object",
                "content": {
                "application/json": {
                    "schema": {
                    "$ref": "#/components/schemas/MovieExtraDetails"
                    }
                }
                }
            },
            "404": {
                "description": "Movie not found"
            }
            }
        }
        },

      "/movies/search": {
        "get": {
          "tags" : ["Movies"],
          "summary" : "Open the search page to search for movies using filters",
          "responses": {
            "200": {
              "description": "Search page opened successfully",
              "content": {
                "text/html": {
                  "schema": {
                    "type": "string"
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error"
            }
          }
        }
      },

      "/movies/movies": {
        "get": {
          "tags" : ["Movies"],
          "summary": "Search movies",
          "description": "Returns a list of movies based on search filters. Acts as a proxy to a backend search API.",
          "parameters": [
            {
              "name": "filmName",
              "in": "query",
              "description": "Title of the movie to search for",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "filmDate",
              "in": "query",
              "description": "Release date of the movie",
              "required": false,
              "schema": {
                "type": "string",
                "format": "date"
              }
            },
            {
              "name": "rating",
              "in": "query",
              "description": "Minimum rating filter",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "genre",
              "in": "query",
              "description": "Genre of the movie",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "page",
              "in": "query",
              "description": "Page number for pagination (starts at 0)",
              "required": false,
              "schema": {
                "type": "integer",
                "default": 0
              }
            },
            {
              "name": "sort",
              "in": "query",
              "description": "Field to sort by",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "order",
              "in": "query",
              "description": "Sort order (e.g., asc or desc)",
              "required": false,
              "schema": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ]
              }
            }
          ],
          "responses": {
            "200": {
              "description": "A list of movies",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "movies": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/MovieDetails"
                        }
                      },
                      "page": {
                        "type": "integer"
                      },
                      "totalPages": {
                        "type": "integer"
                      },
                      "totalElements": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "text/html": {
                  "schema": {
                    "type": "string",
                    "description": "Rendered HTML search results"
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error"
            }
          }
        }
            },
      "/reviews" : {
        "get": {
          "tags" : ["Reviews"],
          "summary": "Get reviews for a movie",
          "description": "Returns a list of reviews for a specific movie.",
          "parameters": [
            {
              "name": "title",
              "in": "query",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "A list of reviews",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Review"
                    }
                  }
                }
              }
            },
            "404": {
              "description": "Movie not found"
            }
          }
        }},
       "/oscars/edition/{edition}" : {
        "get": {
          "tags" : ["Oscars"],
          "summary": "Get Oscar edition details",
          "description": "Returns details about a specific Oscar edition.",
          "parameters": [
            {
              "name": "edition",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Oscar edition details",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/OscarEditionDetails"
                  }
                }
              }
            },
            "404": {
              "description": "Oscar edition not found"
            }
          }
        }},
         "/oscars/year/{year}" : {
            "get": {
              "tags" : ["Oscars"],
                "summary": "Get Oscar edition info by year",
                "description": "Returns information about the Oscar edition for a specific year.",
                "parameters": [
                    {
                    "name": "year",
                    "in": "path",
                    "required": true,
                    "schema": {
                        "type": "integer"
                    }
                    }
                ],
                "responses": {
                    "200": {
                    "description": "Oscar edition info",
                    "content": {
                        "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/OscarEditionInfo"
                        }
                        }
                    }
                    },
                    "404": {
                    "description": "Oscar edition not found"
                    }
                }
            }
         },
        "/actors/{name}" : {
            "get" : {
                "tags" : ["Actors"],
                "summary": "Get actor details by name",
                "description": "Returns detailed information about an actor, including their movies and awards.",
                "parameters": [
                    {
                        "name": "name",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Actor details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ActorExtendedDetails"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Actor not found"
                    }
                }
            }
        }

    },
        "components": {
            "schemas": {
                "MovieDetails": {
                "type": "object",
                "properties": {
                    "id": {
                    "type": "string",
                    "description": "Unique identifier for the movie"
                    },
                    "title": {
                    "type": "string",
                    "description": "Title of the movie"
                    },
                    "releaseDate": {
                    "type": "string",
                    "format": "date",
                    "description": "Release date of the movie"
                    },
                    "posterUrl": {
                    "type": "string",
                    "description": "URL of the movie poster",
                    "format": "uri"
                    },
                    "rating": {
                    "type": "number",
                    "format": "double",
                    "description": "Average rating of the movie"
                    },
                    "tagline" : {
                    "type": "string",
                    "description": "Tagline of the movie"
                    }
                }
                },
                "MovieExtraDetails": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier for the movie"
                    },
                    "title": {
                      "type": "string",
                      "description": "Title of the movie"
                    },
                    "releaseDate": {
                      "type": "string",
                      "format": "date",
                      "description": "Release date of the movie"
                    },
                    "posterUrl": {
                      "type": "string",
                      "description": "URL of the movie poster",
                      "format": "uri"
                    },
                    "rating": {
                      "type": "number",
                      "format": "double",
                      "description": "Average rating of the movie"
                    },
                    "tagline" : {
                      "type": "string",
                      "description": "Tagline of the movie"
                    },
                    "genres" : {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "List of genres associated with the movie"
                    },
                    "languages" : {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "List of languages associated with the movie"
                    },
                    "actors" : {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ActorDetails"
                      },
                      "description": "List of actors associated with the movie"
                    }
                  }
                },
              "ActorDetails" : {
                "type": "object",
                "properties": {
                  "name" : {
                    "type": "string",
                    "description": "The first name and the second one of the actor"
                  },
                  "role" : {
                    "type": "string",
                    "description": "The role of the actor in the movie"
                  },
                  "movie" : {
                    "type" : "object",
                    "$ref" : "#/components/schemas/MovieDetails"
                  }
                }
              },
              "ActorExtendedDetails" : {
                "type": "object",
                "properties": {
                  "name" : {
                    "type": "string",
                    "description": "The first name and the last one of the actor"
                  },
                  "numberOfOscars" : {
                    "type" : "integer",
                    "description": "The number of Oscars won by the actor"
                  },
                  "oscarAwards" : {
                    "type" : "array",
                    "items" : {
                      "$ref" : "#/components/schemas/OscarToActors"
                    },
                    "description": "List of Oscar awards won by the actor"
                  },
                  "movies" : {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/MovieDetails"
                    },
                    "description": "List of movies the actor has appeared in"
                  }
                }
              },
                 "OscarToActors" : {
                    "type": "object",
                    "properties": {
                        "name" : {
                            "type": "string",
                            "description": "The name of the Oscar award"
                        },
                        "yearCeremony" : {
                            "type": "integer",
                            "description": "The year the Oscar was awarded"
                        },
                        "category" : {
                            "type": "string",
                            "description": "The category of the Oscar award"
                        },
                        "yearMovie" : {
                            "type": "integer",
                            "description": "The year the movie was released"
                        }
                    }
            },
              "OscarEditionDetails" : {
                "type": "object",
                "properties": {
                  "year" : {
                    "type": "integer",
                    "description": "The year of the Oscar edition"
                  },
                  "edition" : {
                    "type": "integer",
                    "description": "The edition of the Oscar ceremony"
                  },
                  "nominations" : {
                    "type": "array",
                    "items": {
                      "items" : {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "description": "List of nominees for the Oscar category"
                        }
                      }
                  }
                },
                  "winners" : {
                  "type" : "array",
                    "items" : {
                      "type" : "string",
                      "description": "List of winners for the Oscar category"
                    }
                  }
                }
              },
              "OscarEditionInfo" : {
                "type": "object",
                "properties": {
                  "year" : {
                    "type": "integer",
                    "description": "The year of the Oscar edition"
                  },
                  "edition" : {
                    "type": "integer",
                    "description": "The edition of the Oscar ceremony"
                  },
                  "numberOfWinners" : {
                    "type": "integer",
                    "description": "The number of winners in the Oscar edition"
                  }
                }
              },
              "Review" : {
              "type": "object",
                "properties": {
                  "_id" : {
                    "type": "integer",
                    "description": "The unique identifier of the review",
                    "example": 1012324
                  },
                  "movie_title" : {
                    "type": "string",
                    "description": "The title of the review",
                    "example": "Hangover III"
                  },
                  "review_content" : {
                    "type": "string",
                    "description": "The content of the review",
                    "example": "This movie was a great sequel to the original Hangover. The plot was engaging and the characters were well-developed."
                  },
                  "critic_name" : {
                    "type": "string",
                    "description": "The author of the review",
                    "example": "John Doe"
                  },
                  "rating" : {
                    "type": "number",
                    "format": "double",
                    "description": "The rating given in the review",
                    "example": 2.5
                  },
                  "rotten_tomatoes_link" : {
                    "type": "string",
                    "description": "The link to the Rotten Tomatoes page for the review",
                    "format": "uri"
                  },
                  "publisher_name" : {
                    "type": "string",
                    "description": "The name of the publisher of the review"
                  },
                  "review_date" : {
                    "type": "string",
                    "format": "date",
                    "description": "The date the review was published"
                  },
                  "review_type" : {
                    "type": "string",
                    "description": "The type of the review"
                  },
                  "top_critic" : {
                    "type": "boolean",
                    "description": "Indicates if the critic is a top critic"
                  }
                }
              },
              "IndexData" : {
                "type": "object",
                "properties": {
                  "bestMovies" : {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/MovieDetails"
                    },
                    "description": "List of the best movies based on rating"
                  },
                  "latestOscars" : {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/OscarEditionInfo"
                    },
                    "description": "List of the latest 5 Oscar editions"
                  },
                  "suggestedMovies" : {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/MovieDetails"
                    },
                    "description": "List of 5 suggested movies"
                  }
                }
              }
            } }
}



