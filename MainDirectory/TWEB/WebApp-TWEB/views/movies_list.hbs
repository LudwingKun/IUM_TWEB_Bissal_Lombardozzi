<head>
    <meta charset="UTF-8">
    <title>Lista Film</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <!--    <style>
            body {
                background-color: black; /* Colore di sfondo nero */
                color: #fff; /* Testo bianco di default */
            }
        </style>-->
</head>
<body>
<h1>Results </h1>

{{#if movies.length}}
    <p>numero di film : {{movies.length}}</p>
    <ul>
        {{#each movies}}
            <li>
                <div class="card bg-dark text-white mb-3">
                    <div class="card-body">
                        <h5 class="card-title">
                            <a href="/movies/{{this.id}}" class="text-warning text-decoration-none">
                                {{this.name}} ({{this.date}})
                            </a>
                        </h5>
                        <p class="card-text mb-1">
                            <strong>Rating:</strong> {{this.rating}}
                        </p>
                        <p class="card-text">
                            <strong>Durata:</strong> {{this.minute}} minuti
                        </p>
                    </div>
                </div>

            </li>
        {{/each}}
    </ul>
{{else}}
    <p>Nessun film trovato con i filtri selezionati.</p>
{{/if}}

<div class="mt-4 mb-4 ms-4 text-start">
    <a href="/" class="btn btn-warning">
    Home
    </a>
</div>
</body>
</html>
