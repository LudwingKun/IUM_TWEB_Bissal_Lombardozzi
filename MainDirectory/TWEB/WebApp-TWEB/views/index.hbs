<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>MovieHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="../public/stylesheets/index.css" rel="stylesheet"/>
</head>
<body>
<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="#">QuieroMovies</a>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"> <button class="btn btn-black ms-auto me-2" onclick="location.href='movies/search'">Search</button></li>
                <li class="nav-item"><a class="nav-link" href="">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Movies</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Actors</a></li>
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">
    <h2 class="section-title">Best movies per rating</h2>
    <div class="row row-cols-1 row-cols-md-5 g-4">
        {{#each topMovies}}
            <div class="col">
                <div class="card h-100">
                    <img src="{{this.posterUrl}}" class="card-img-top" alt="{{this.title}}">
                    <div class="card-body" onclick="location.href='movies/{{this.id}}'" style="cursor: pointer;">
                        <h5 class="card-title">{{this.title}}</h5>
                        <p class="card-text">Rating: {{this.rating}}</p>
                    </div>
                </div>
                </div>
        {{/each}}
    </div>

    <h2 class="section-title mt-5">Latest Oscars</h2>
    <div class="row">
        {{#each latestOscars}}
            <div class="col-md-12 mb-3">
                <div class="card bg-dark text-white border-warning">
                    <div class="card-body d-flex justify-content-between align-items-center"
                         onclick="location.href='oscars/edition/{{this.edition}}'"
                         style="cursor: pointer;">
                        <div>
                            <h5 class="card-title text-warning">{{this.edition}}° Academy Awards</h5>
                            <p class="card-text">Anno: {{this.year}}</p>
                        </div>
                    </div>
                </div>
            </div>
        {{/each}}
    </div>



    <h2 class="section-title mt-5">Movies suggestions</h2>
    <div class="row row-cols-1 row-cols-md-5 g-4">
        {{#each suggestedMovies}}
            <div class="col">
                <div class="card h-100">
                    {{#if this.posterUrl}}
                        <img src="{{this.posterUrl}}" class="card-img-top" alt="{{this.title}}">
                    {{else}}
                        <img src="../public/images/question-mark.png" class="card-img-top" alt="Poster non disponibile" style="object-fit: cover; width: 100%; height: 100%;">
                    {{/if}}
                    <div class="card-body" onclick="location.href='movies/{{this.id}}'" style="cursor: pointer;">
                        <h5 class="card-title">{{this.title}}</h5>
                        <p class="card-text">Rating: {{#if this.rating}}{{this.rating}}{{else}}Unknown{{/if}}</p>
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
