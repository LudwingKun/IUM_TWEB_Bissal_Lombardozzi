<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>MovieHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <style>
        :root {
            --mustard: #FFCC00;
            --dark: #000000;
        }

        body {
            background-color: var(--dark);
            color: white;
        }

        .navbar {
            background-color: var(--mustard);
        }

        .navbar-brand,
        .nav-link {
            color: black !important;
            font-weight: bold;
        }

        .section-title {
            color: var(--mustard);
            margin-top: 2rem;
            border-bottom: 2px solid var(--mustard);
            padding-bottom: 0.5rem;
        }

        .card {
            background-color: #1c1c1c;
            border: 1px solid var(--mustard);
        }

        .card-title {
            color: var(--mustard);
        }
    </style>
</head>
<body>
<!-- Header & Navbar -->
<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="#">🎬 MovieHub</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Film</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Attori</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Contatti</a></li>
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">
    <h2 class="section-title">Top films per rating ⭐</h2>
    <div class="row row-cols-1 row-cols-md-5 g-4">
        {{#each topMovies}}
            <div class="col">
                <a href="/movies/{{this.id}}"></a>
                <div class="card h-100">
                    <img src="{{this.poster}}" class="card-img-top" alt="{{this.filmName}}">
                    <div class="card-body">
                        <h5 class="card-title">{{this.filmName}}</h5>
                        <p class="card-text">{{this.filmRating}}</p>
                    </div>
                </div>
                </div>
        {{/each}}
    </div>

    <h2 class="section-title mt-5">🏆 Ultimi 5 Premi Oscar</h2>
    <ul class="list-group list-group-flush">
        {{#each oscars}}
            <li class="list-group-item bg-dark text-white border-warning">
                <strong>{{this.category}}:</strong> {{this.winner}} ({{this.movie}})
            </li>
        {{/each}}
    </ul>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
