<head>
    <title>Movies with {{name}}</title>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-dark text-light">
<div class="container mt-4">
    <div class="mb-4 text-center">
        <h2 class="text-warning">Movies with {{name}}</h2>
        <p class="text-light fs-5">🏆 Total Oscars: <strong>{{totalOscars}}</strong></p>
    </div>

    <div class="position-sticky top-0 end-0 p-3" style="z-index: 1000;">
        <a href="/" class="btn btn-light btn-lg">🏠</a>
    </div>
    {{#if oscars.length}}
        <div class="accordion mb-4" id="oscarsAccordion">
            <div class="accordion-item bg-dark border-light">
                <h2 class="accordion-header">
                    <button class="accordion-button bg-success text-white" type="button" data-bs-toggle="collapse"
                            data-bs-target="#oscarsList">
                        🎖️ Oscar Awards ({{totalOscars}})
                    </button>
                </h2>
                <div id="oscarsList" class="accordion-collapse collapse show" data-bs-parent="#oscarsAccordion">
                    <div class="accordion-body">
                        <ul class="list-group list-group-flush">
                            {{#each oscars}}
                                <li class="list-group-item bg-dark text-white border-secondary">
                                    <strong>{{category}}</strong><br>
                                    🎥 Movie: {{nameActor}}<br>
                                    🗓️ Year of Film: {{yearFilm}}<br>
                                    🎬 Ceremony Year: {{yearCeremony}}<br>
                                    👤 Winner: {{nameActor}}
                                </li>
                            {{/each}}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    {{/if}}
    {{#if movies.length}}
        <div class="accordion mb-5" id="moviesAccordion">
            <div class="accordion-item bg-dark">
                <h2 class="accordion-header">
                    <button class="accordion-button bg-secondary text-white" type="button" data-bs-toggle="collapse"
                            data-bs-target="#moviesList">
                        Show Movies List ({{movies.length}} results)
                    </button>
                </h2>
                <div id="moviesList" class="accordion-collapse collapse show" data-bs-parent="#moviesAccordion">
                    <div class="accordion-body">
                        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                            {{#each movies}}
                                <div class="col">
                                    <div class="card h-100 bg-secondary text-white">
                                        <img src="{{posterUrl}}" class="card-img-top" alt="{{title}}">
                                        <div class="card-body">
                                            <h5 class="card-title">{{title}} ({{releaseDate}})</h5>
                                            <p class="card-text" style="font-style: italic;">{{tagline}}</p>
                                        </div>
                                        <div class="card-footer">
                                            <small class="text-light">⭐ Rating: {{rating}}</small>
                                            <br>
                                            <a href="/movies/{{id}}" class="btn btn-warning mt-2">View Details</a>
                                        </div>
                                    </div>
                                </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {{else}}
        <p class="text-center">No movies found for this actor.</p>
    {{/if}}


    <div class="mt-5 text-center">
        <a href="/" class="btn btn-light">Back to Home</a>
    </div>
</div>
</body>
