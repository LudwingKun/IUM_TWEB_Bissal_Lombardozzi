<head>
    <title>Movies with {{name}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-dark text-light">
<div class="container mt-4">
    <div class="mb-4 text-center">
        <h2 class="text-warning">Movies with {{name}}</h2>
    </div>

    {{#if movies.length}}
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
            {{#each movies}}
                <div class="col">
                    <div class="card h-100 bg-secondary text-white">
                        <img src="{{posterUrl}}" class="card-img-top" alt="{{title}}">
                        <div class="card-body">
                            <h5 class="card-title">{{title}} ({{releaseDate}})</h5>
                            <p class="card-text" style="font-style: italic;">{{tagline}}</p>
                        </div>
                        <div class="card-footer">
                            <small class="text-light">⭐ Rating: {{rating}}</small>
                            <br>
                            <a href="/movies/{{id}}" class="btn btn-warning mt-2">View Details</a>
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>
    {{else}}
        <p class="text-center">No movies found for this actor.</p>
    {{/if}}

    <div class="mt-5 text-center">
        <a href="/" class="btn btn-light">Back to Home</a>
    </div>
</div>
</body>
