<head>
    <title>{{movie.title}}</title>
    <link rel="stylesheet" href="/styles/movie_info.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-dark text-light">
<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <img src="{{#if movie.posterUrl}}{{movie.posterUrl}}{{else}}/images/question-mark.png{{/if}}" class="img-fluid rounded" alt="{{movie.title}}">
        </div>
        <div class="col-md-8">
            <h2 class="text-warning">{{movie.title}} ({{movie.releaseDate}})</h2>
            <br>
            <p class="mb-2" style="font-style: italic"><span>{{movie.tagline}}</span></p>
            <br>
            <p class="mb-2"><span class="fw-semibold text-warning">Rating:</span> {{movie.rating}}</p>
            <p><span class="fw-semibold text-warning">Duration:</span> {{movie.duration}}'</p>
            <p><span class="fw-semibold text-warning">Language:</span> {{movie.languages}}</p>
            <p><span class="fw-semibold text-warning">Genres:</span>
                {{#each movie.genres}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
            </p>
            <p>{{movie.description}}</p>
        </div>
    </div>

    <div class="mt-4 text-end">
        <button class="btn btn-warning ms-auto me-2" onclick="window.location.href='/reviews?movie_title={{encodeURI movie.title}}'" style="cursor: pointer;">Reviews</button>
    </div>

    <div class="mt-5">
        <h4 class="text-warning">Cast</h4>
        <ul class="list-group list-group-flush">
            {{#each movie.actors}}
                <li class="list-group-item bg-secondary text-white">
                    {{this.name}} as {{#if this.role}}{{this.role}}{{else}}<span style="font-style: italic">Unknown</span>{{/if}}
                </li>
            {{/each}}

        </ul>
    </div>

    {{#if movie.awards.length}}
        <div class="mt-5">
            <h4 class="text-warning">Rewards</h4>
            <ul class="list-group list-group-flush">
                {{#each movie.awards}}
                    <li class="list-group-item bg-secondary text-white">{{this}}</li>
                {{/each}}
            </ul>
        </div>
    {{/if}}


    <hr>
    <h4 class="text-warning">Fan chat for: {{movie.title}}</h4>
    <div id="chat-box" data-movie="{{movie.title}}">
        <div id="messages" class="mb-3 border p-3 bg-light text-dark" style="height: 300px; overflow-y: auto;"></div>
        <form id="chat-form" class="d-flex gap-2">
            <input id="chat-input" class="form-control" placeholder="Type a message...">
            <button class="btn btn-warning" type="submit">Send</button>
        </form>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/public/js/chat.js"></script>

</div>
</body>
