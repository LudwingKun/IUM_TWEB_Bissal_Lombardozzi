<head>
    <title></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="../../WebApp-TWEB/public/styles/movie_info.css">
    <style>
        body {
            background-color: black; /* Colore di sfondo nero */
            color: #fff; /* Testo bianco di default */
        }
    </style>
</head>
<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <img src="{{posterLink}}" class="img-fluid rounded" alt="{{movie.title}}">
        </div>

        <div class="col-md-8 text-white">
            <h2>{{movie.filmName}} ({{movie.filmDate}})</h2>
            <p class="text-warning">Rating: {{movie.filmRating}}</p>
            <p><strong>Language:</strong> {{movie.language}}</p>
            <p><strong>Genres:</strong> {{#each movie.genres}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
            <p>{{movie.filmDescription}}</p>
        </div>
    </div>

    <div class="mt-5">
        <h4 class="text-warning">Actors</h4>
        <ul class="list-group list-group-flush">
            {{#each movie.actors}}
                <li class="list-group-item bg-dark text-white">{{this.name}}</li>
            {{/each}}
        </ul>
    </div>

    {{#if movie.awards.length}}
        <div class="mt-5">
            <h4 class="text-warning">Premi</h4>
            <ul class="list-group list-group-flush">
                {{#each movie.awards}}
                    <li class="list-group-item bg-dark text-white">{{this}}</li>
                {{/each}}
            </ul>
        </div>
    {{/if}}
</div>
