<head>
    <meta charset="UTF-8">
    <title>Recensioni</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="bg-black text-white">
<div class="container mt-4">
    <h1 class="text-warning">Recensioni per {{movie_title}}</h1>

    {{#if reviews.length}}
        <p>Numero recensioni: {{reviews.length}}</p>
        <ul class="list-unstyled">
            {{#each reviews}}
                <li>
                    <div class="card bg-dark text-white mb-3">
                        <div class="card-body">
                            <h5 class="card-title text-warning">{{this.critic_name}}</h5>
                            <h6 class="card-subtitle mb-2 text-muted">{{this.date}}</h6>
                            <p class="card-text">{{this.review_content}}</p>
                        </div>
                    </div>
                </li>
            {{/each}}
        </ul>
    {{else}}
        <p>Nessuna recensione trovata.</p>
    {{/if}}

    <div class="mt-4 mb-4">
        <a href="/" class="btn btn-warning">Home</a>
    </div>
</div>
</body>
