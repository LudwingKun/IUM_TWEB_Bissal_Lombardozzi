<head>
    <meta charset="UTF-8">
    <title>Oscar {{oscar_ceremony.edition}}° Edizione</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="bg-black text-white">
<div class="container mt-4">
    <h1 class="text-warning">{{oscar_ceremony.edition}}° Academy Awards - {{oscar_ceremony.year}}</h1>

    <div class="row mt-4">
        <div class="col-md-6">
            <h2 class="text-warning">Winners</h2>
            <ul class="list-unstyled">
                {{#each oscar_ceremony.winners}}
                    <li>
                        <div class="card bg-dark text-white mb-3">
                            <div class="card-body">
                                <p class="card-text">
                                    <a href="/actors/{{@key}}" class="text-white text-decoration-none">
                                        <span class="text-warning">{{@key}}</span> for <span>{{#if this}}{{this}}{{else}}
                                        Unknown{{/if}}</span>
                                    </a>
                                </p>
                            </div>
                        </div>
                    </li>
                {{/each}}
            </ul>
        </div>

        <div class="col-md-6">
            <h2 class="text-warning">Nominations</h2>
            <ul class="list-unstyled">
                {{#each oscar_ceremony.nominations}}
                    <li>
                        <div class="card bg-dark text-white mb-3">
                            <div class="card-body">
                                <p class="card-text">
                                    <a href="/actors/{{@key}}" class="text-white text-decoration-none">
                                        <span class="text-warning">{{@key}}</span> in <span style="font-style: italic">{{#if this}}{{this}}{{else}}
                                        Unknown{{/if}}</span>
                                    </a>
                                </p>
                            </div>
                        </div>
                    </li>
                {{/each}}
            </ul>
        </div>
    </div>

    <div class="mt-4 mb-4">
        <a href="/" class="btn btn-warning">Home</a>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>