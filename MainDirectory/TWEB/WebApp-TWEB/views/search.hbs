<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>Ricerca Film</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles/movie_info.css">
</head>
<body>
<div class="container py-5">
    <h1 class="text-center mb-4 text-warning">Search for Movies</h1>
    <div class="text-center mb-4">
        <a href="/" class="btn btn-outline-light btn-lg">🏠 Torna alla Home</a>
    </div>
    <form id="search-form" class="row g-3 bg-dark p-4 rounded shadow" method="get" action="/movies/movies">
        <div class="col-md-6">
            <label for="title" class="form-label text-warning">Title</label>
            <input type="text" name="filmName" id="title" class="form-control" placeholder="Insert title here">
        </div>

        <div class="col-md-6">
            <label for="genre" class="form-label text-warning">Genre</label>
            <select name="genre" id="genre" class="form-select">
                <option value="">All</option>
                <option value="Action">Action</option>
                <option value="Comedy">Comedy</option>
                <option value="Crime">Crime</option>
                <option value="Drama">Drama</option>
                <option value="Thriller">Thriller</option>
                <option value="Horror">Horror</option>
                <option value="History">History</option>
                <option value="Science-Fiction">Science-Fiction</option>
                <option value="Mystery">Mystery</option>
                <option value="Romance">Romance</option>
                <option value="Adventure">Adventure</option>
                <option value="Fantasy">Fantasy</option>
                <option value="Animation">Animation</option>
                <option value="Documentary">Documentary</option>
                <option value="War">War</option>
                <option value="Western">Western</option>
            </select>
        </div>

        <div class="col-md-4">
            <label for="year" class="form-label text-warning">Year</label>
            <input type="number" name="filmDate" id="year" class="form-control" placeholder="Esempio: 2010">
        </div>

        <div class="col-md-4">
            <label for="rating" class="form-label text-warning">Minimum Rating</label>
            <input type="number" step="0.1" min="0" max="5" name="rating" id="rating" class="form-control"
                   placeholder="Example: 4.5">
        </div>

        <div class="col-md-4">
            <label for="sort" class="form-label text-warning">Sort by</label>
            <select id="sort" class="form-select" name="sort">
                <option value="">Nessun ordinamento</option>
                <option value="title">Titolo</option>
                <option value="year">Anno</option>
                <option value="rating">Rating</option>
            </select>
        </div>

        <div class="col-12 text-center">
            <button type="submit" class="btn btn-primary px-5">🔍 Search</button>
        </div>
    </form>

    <hr class="bg-light my-5">


    <h2 class="text-center text-warning">Results</h2>

    <div id="results-list" class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 g-4">
        {{#each movies.content}}
            <div class="col">
                <div class="card h-100 shadow-sm bg-dark text-light border-warning">
                    <img src="{{posterUrl}}" class="card-img-top" alt="Poster for {{title}}"
                         style="height: 400px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-warning">{{title}}</h5>
                        <p class="card-subtitle mb-2 text-muted fst-italic">{{tagline}}</p>
                        <p class="card-text mt-auto">
                            <strong>Release:</strong> {{releaseDate}}<br>
                            <strong>Rating:</strong> ⭐ {{rating}} / 5
                        </p>
                        <a href="/movies/{{id}}" class="btn btn-outline-warning mt-3">🎬 View</a>
                    </div>
                </div>
            </div>
        {{/each}}
        <div class="d-flex justify-content-end mt-4">
            {{#if (gt currentPage 0)}}
                <a href="/movies/movies?filmName={{filmName}}&genre={{genre}}&filmDate={{filmDate}}&rating={{rating}}
                &sort={{sort}}&page={{subtract currentPage 1}}" class="btn btn-outline-warning me-2">
                ⬅️ Indietro
                </a>
            {{else}}
                <button class="btn btn-outline-secondary btn-sm  me-2" disabled>⬅️ Indietro</button>
            {{/if}}

            {{#if (lt currentPage  totalPages)}}
                <a href="/movies/movies?filmName={{filmName}}&genre={{genre}}&filmDate={{filmDate}}&rating={{rating}}
                &sort={{sort}}&page={{add currentPage 1}}" class="btn btn-outline-warning btn-sm">
                Avanti ➡️
                </a>
            {{else}}
                <button class="btn btn-outline-secondary" disabled>Avanti ➡️</button>
            {{/if}}
        </div>

    </div>
</div>

</body>
</html>
