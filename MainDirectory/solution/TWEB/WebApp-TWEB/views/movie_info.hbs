<head>
    <title>{{#if movie.title}}{{movie.title}}{{else}}Not available{{/if}}</title>
    <link rel="stylesheet" href="../public/stylesheets/movie_info.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-dark text-light position-relative">
<div class="position-sticky top-0 end-0 p-3" style="z-index: 1000;">
    <a href="/" class="btn btn-light btn-lg">🏠</a>
</div>
<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <img src="{{#if movie.posterUrl}}{{movie.posterUrl}}{{else}}../public/images/question-mark.png{{/if}}"
                 class="img-fluid rounded" alt="{{#if movie.title}}{{movie.title}}{{else}}Not available{{/if}}">
        </div>
        <div class="col-md-8">
            <h2 class="text-warning">
                {{#if movie.title}}{{movie.title}}{{else}}Not available{{/if}}
                ({{#if movie.releaseDate}}{{movie.releaseDate}}{{else}}Not available{{/if}})
            </h2>
            <br>
            <p class="mb-2" style="font-style: italic">
                <span>{{movie.tagline}}</span>
            </p>
            <br>
            <p class="mb-2">
                <span class="fw-semibold text-warning">Rating:</span>
                {{#if movie.rating}}{{movie.rating}}{{else}}Not available{{/if}}
            </p>
            <p>
                <span class="fw-semibold text-warning">Duration: </span>
                {{#if movie.duration}}{{movie.duration}}'{{else}}Not available{{/if}}
            </p>
            <p>
                <span class="fw-semibold text-warning">Languages: </span>
                {{#if movie.languages}}{{movie.languages}}{{else}}Not available{{/if}}
            </p>
            <p>
                <span class="fw-semibold text-warning">Genres: </span>
                {{#if movie.genres}}
                    {{#each movie.genres}}
                        {{this}}{{#unless @last}}, {{/unless}}
                    {{/each}}
                {{else}}
                    Not available
                {{/if}}
            </p>
            <p>
                {{#if movie.description}}{{movie.description}}{{else}}Not available{{/if}}
            </p>
        </div>
    </div>

    <div class="mt-4 text-end">
        <button class="btn btn-warning ms-auto me-2" onclick="window.location.href='/reviews?movie_title={{#if movie.title}}{{encodeURI movie.title}}{{else}}Not available{{/if}}'" style="cursor: pointer;">Reviews</button>
    </div>

    <div class="mt-5">
        <h4 class="text-warning">Cast</h4>
        <ul class="list-group list-group-flush">
            {{#if movie.actors}}
                {{#each movie.actors}}
                    <li class="list-group-item bg-secondary text-white">
                        <a href="/actors/{{this.name}}" class="text-white text-decoration-none">
                            {{#if this.name}}{{this.name}}{{else}}Not available{{/if}} as
                            {{#if this.role}}{{this.role}}{{else}}
                                <span style="font-style: italic">Not available</span>
                            {{/if}}
                        </a>
                    </li>
                {{/each}}
            {{else}}
                <li class="list-group-item bg-secondary text-white">Not available</li>
            {{/if}}
        </ul>
    </div>

    <hr>
    <h4 class="text-warning">Fan chat for: {{#if movie.title}}{{movie.title}}{{else}}Not available{{/if}}</h4>
    <div id="chat-box" data-movie="{{#if movie.title}}{{movie.title}}{{else}}Not available{{/if}}">
        <div id="messages" class="mb-3 border p-3 bg-light text-dark" style="height: 300px; overflow-y: auto;"></div>
        <form id="chat-form" class="d-flex gap-2">
            <input id="chat-input" class="form-control" placeholder="Type a message...">
            <button class="btn btn-warning" type="submit">Send</button>
        </form>
    </div>

    <script src="../socket.io/socket.io.js"></script>
    <script src="../public/js/chat.js"></script>

</div>
</body>
